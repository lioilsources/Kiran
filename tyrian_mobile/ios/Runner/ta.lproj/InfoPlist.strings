"NSBluetoothAlwaysUsageDescription" = "நீங்கள் ஒரே Wi-Fi இல் இல்லாதபோது உள்ளூர் கூட்டாட்டத்திற்கு அருகிலுள்ள ஆட்டக்காரரைக் கண்டறிய Kirian புளூடூத்தைப் பயன்படுத்துகிறது.";
"NSBluetoothPeripheralUsageDescription" = "நீங்கள் ஒரே Wi-Fi இல் இல்லாதபோது உள்ளூர் கூட்டாட்டத்திற்கு அருகிலுள்ள ஆட்டக்காரரைக் கண்டறிய Kirian புளூடூத்தைப் பயன்படுத்துகிறது.";
"NSLocalNetworkUsageDescription" = "Kirian உங்கள் Wi-Fi அல்லது அருகிலுள்ள சாதனங்களில் நடத்தப்படும் கூட்டாட்டங்களைத் தேடுகிறது; மற்ற ஆட்டக்காரர்கள் உங்களுடையதைக் கண்டறியவும் அனுமதிக்கிறது.";
"NSMicrophoneUsageDescription" = "Kirian மைக்ரோஃபோனைப் பயன்படுத்துவதில்லை. ஆடியோ கட்டமைப்புக்கு இந்த அனுமதி தேவை.";
