<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Co-op hosting binds a listening socket (CoopHost.start -> ServerSocket.bind).
	     The sandbox denies that without this key, so release builds could join a
	     game but never host one. It was only ever set in DebugProfile.entitlements,
	     which is why hosting worked while developing and not in a shipped build. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.device.bluetooth</key>
	<true/>
	<key>com.apple.security.device.usb</key>
	<true/>
	<key>com.apple.developer.game-center</key>
	<true/>
</dict>
</plist>
