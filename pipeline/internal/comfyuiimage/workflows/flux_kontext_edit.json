{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model" },
    "inputs": { "unet_name": "flux1-dev-kontext_fp8_scaled.safetensors", "weight_dtype": "fp8_e4m3fn" }
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "_meta": { "title": "DualCLIPLoader" },
    "inputs": { "clip_name1": "clip_l.safetensors", "clip_name2": "t5xxl_fp16.safetensors", "type": "flux", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE" },
    "inputs": { "vae_name": "ae.safetensors" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Edit Instruction" },
    "inputs": { "text": "placeholder edit", "clip": ["2", 0] }
  },
  "11": {
    "class_type": "LoadImage",
    "_meta": { "title": "Source Image" },
    "inputs": { "image": "source.png" }
  },
  "12": {
    "class_type": "FluxKontextImageScale",
    "_meta": { "title": "FluxKontextImageScale" },
    "inputs": { "image": ["11", 0] }
  },
  "13": {
    "class_type": "VAEEncode",
    "_meta": { "title": "VAE Encode" },
    "inputs": { "pixels": ["12", 0], "vae": ["3", 0] }
  },
  "14": {
    "class_type": "ReferenceLatent",
    "_meta": { "title": "ReferenceLatent" },
    "inputs": { "conditioning": ["4", 0], "latent": ["13", 0] }
  },
  "7": {
    "class_type": "FluxGuidance",
    "_meta": { "title": "FluxGuidance" },
    "inputs": { "conditioning": ["14", 0], "guidance": 2.5 }
  },
  "15": {
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "ConditioningZeroOut" },
    "inputs": { "conditioning": ["4", 0] }
  },
  "8": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler" },
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": ["1", 0],
      "positive": ["7", 0],
      "negative": ["15", 0],
      "latent_image": ["13", 0]
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": { "samples": ["8", 0], "vae": ["3", 0] }
  },
  "10": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" },
    "inputs": { "filename_prefix": "tyrian_edit", "images": ["9", 0] }
  }
}
